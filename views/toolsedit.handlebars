<form action="/toolsedit/{{tool._id}}" id="edit-tool-info" name="edit-tool-info" method="POST">
    <input type="text" name="testField" value="testValue">
<input type="text" id="toolId" name="toolId" value="{{tool._id}}" />
    <input type="text" id="userID" name="userID" value="{{tool.userID}}" />
    <input type="hidden" id="dateAdded" name="dateAdded" value="{{tool.dateAdded}}" />
    {{!-- <input type="hidden" id="images" name="images" value="{{tool.images}}" /> --}}
    
    <input type="hidden" id="availabilitystart" name="availabilitystart" value="{{tool.availability.start}}" />
    <input type="hidden" id="availabilityend" name="availabilityend" value="{{tool.availability.end}}" />
    <input type="hidden" id="location" name="location" value="{{tool.location}}" />
    <input type="hidden" id="lat" name="lat" value="{{tool.lat}}" />
    <input type="hidden" id="lng" name="lng" value="{{tool.lng}}" />
    <label for="toolName">Tool Name</label>
    <input type="text" id="toolName" name="toolName" value="{{tool.toolName}}" /><br>
    <input type="hidden" id="oldimage" name="oldimage" value="{{tool.image}}" />
    <img src="/public/uploads/{{tool.image}}" alt="Image of {{tool.toolName}}" style="width:100px; height:100px;"><br>
    <label for="image">Image of Product (Upload new to replace)</label>
    <input type="file" accept="image/*" id="newimage" name="newimage"><br>
    {{!-- <input type="hidden" id="changeimage" name="changeimage" value="false"> --}}
    <input type="checkbox" id="changeimage" name="changeimage" value="false">
    
    <label for="changeimage">Check to change image</label><br>
    <label for="description">Description</label>
    <input type="text" id="description" name="description" value="{{tool.description}}" /><br>
    <p>Previous Description - {{tool.condition}}</p>
    <label for="condition">Previous Condition - {{tool.condition}} </label>
    <select name="condition" id="condition">
                <option value="Like New">Like New</option>
                <option value="Very Good">Very Good</option>
                <option value="Good">Good</option>
                <option value="Ok">ok</option>
                <option value="Minor Damage">Minor Damage</option>
                <option value="Some Damage">Some Damage</option>
                <option value="Very Damaged">Very Damaged</option>
    </select><br>

    <button type="submit">Submit</button>
</form>

