        <script>
    const calendar = document.getElementById('calendar').getElementsByTagName('tbody')[0];
    const today = new Date();
    var selectedDates = []; // Array to store selected dates
    let currentMonth = today.getMonth();
    let currentYear = today.getFullYear();
    function generateCalendar(month, year) {
        calendar.innerHTML = '';
        
        const firstDay = new Date(year, month, 1);
        const lastDay = new Date(year, month + 1, 0);
        const daysInMonth = lastDay.getDate();
        const startingDay = firstDay.getDay();
        monthYear.textContent = `${firstDay.toLocaleString('default', { month: 'long' })} ${year}`;
        let dayCounter = 1;
        calendar.insertRow()
        const daysOfWeek = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
        const headerRow = calendar.insertRow();
        daysOfWeek.forEach(day => {
        const headerCell = headerRow.insertCell();
        headerCell.textContent = day;
        headerCell.classList.add('day-header'); // Add any necessary styling class for the header
        }); 
        // Loop through 6 rows (maximum number of rows in a month)
        for (let i = 0; i < 6; i++) {
            const row = calendar.insertRow();
            
            // Loop through each day of the week
            for (let j = 0; j < 7; j++) {
                const cell = row.insertCell();
                
                // Empty cells before the start of the month
                if (i === 0 && j < startingDay) {
                    cell.textContent = '';
                } else if (dayCounter <= daysInMonth) {
                    // Insert the day number and make it available
                    cell.textContent = dayCounter;
                    cell.classList.add('available');
                    cell.addEventListener('click', toggleAvailability);
                    dayCounter++;
                }
            }
            
            // Stop when all days of the month are added
            if (dayCounter > daysInMonth) break;
        }
    }

    // Toggle availability of a day when clicked
    function toggleAvailability() {
        console.log('clicked');
        const date = `${currentYear}-${currentMonth + 1}-${this.textContent}`;
        console.log(date);
        if (this.classList.contains('available')) {
            this.classList.remove('available');
            this.classList.add('unavailable');
            selectedDates.push(date); // Add the date to the selectedDates array
            // Add the date to the selectedDates input field
            
        } else {
            this.classList.remove('unavailable');
            this.classList.add('available');
            // Remove the date from the selectedDates array
            selectedDates = selectedDates.filter(d => d !== date);
            //selectedDates.pop(date); // Remove the date from the selectedDates array
            
        }
        console.log("Selected dates:");
        console.log(selectedDates);
        console.log(selectedDates.length);
        // Update the hidden input field with the selected dates
        
        console.log(document.getElementById('selectedDatesfield').value);
        document.getElementById('selectedDatesfield').value = selectedDates.join(',');
        document.getElementById('selectedDatesDisplay').textContent = selectedDates.join(', ');
        console.log("Selected dates: listtttttttt");
    }

    // Generate the calendar for the current month and year
    generateCalendar(currentMonth, currentYear);

document.getElementById('next').addEventListener('click', () => {
        currentMonth++;  // Move to the next month
        if (currentMonth > 11) {  // If the month goes above 11 (i.e., Dec), reset to January of the next year
            currentMonth = 0;
            currentYear++;
        }
        generateCalendar(currentMonth, currentYear);  // Regenerate the calendar
    });

document.getElementById('prev').addEventListener('click', () => {
        currentMonth--;  // Move to the previous month
        if (currentMonth < 0) {  // If the month goes below 0 (i.e., Jan), reset to December of the previous year
            currentMonth = 11;
            currentYear--;
        }
        generateCalendar(currentMonth, currentYear);  // Regenerate the calendar
    });

</script>


        <script>
            function initAutocomplete() {
            // Get the input element
            var input = document.getElementById('autocomplete');
    
            // Initialize the autocomplete object
            var autocomplete = new google.maps.places.Autocomplete(input);
            // Optionally, you can add an event listener to handle the place selection
            }
            // Initialize the autocomplete when the page loads
            window.addEventListener('load', initAutocomplete);
        </script>

